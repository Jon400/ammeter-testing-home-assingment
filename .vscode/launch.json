{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run tests on all ammeters (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Results viewer (viewer.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/viewer.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
